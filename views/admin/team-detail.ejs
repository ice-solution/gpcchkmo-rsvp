<%- include('partials/head') %>
<%
  var captain = (players || []).find(function(p){ return p.role === PLAYER_ROLES.CAPTAIN; }) || null;
  var teammate = (players || []).find(function(p){ return p.role === PLAYER_ROLES.TEAMMATE; }) || null;
  var tier = (paymentLinks && paymentLinks.packTier) || team.packTier || (team.wantPlayerPack ? 'essential' : 'standard');
%>
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <div>
    <a href="/admin" class="text-sm text-brand-blue hover:underline">← 返回列表</a>
    <h1 class="mt-1 font-display text-2xl font-bold text-brand-deep">報名詳情</h1>
    <p class="mt-1 font-mono text-xs text-slate-500"><%= team._id %></p>
  </div>
  <% if (team.teamCode) { %>
  <div class="rounded-xl bg-brand-lime/40 px-4 py-2 font-mono text-sm font-bold text-brand-deep"><%= team.teamCode %></div>
  <% } %>
</div>

<% if (flash) { %>
<div class="mb-4 rounded-xl bg-emerald-50 px-4 py-2 text-sm text-emerald-800 ring-1 ring-emerald-200"><%= flash %></div>
<% } %>

<div class="grid gap-5 lg:grid-cols-3">
  <section class="space-y-4 lg:col-span-2">
    <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-deep">付款連結（給用戶付款／上載憑證）</h2>
      <p class="mt-1 text-xs text-slate-500">可複製傳送給隊長；付款頁可完成 Airwallex 付款並上載收據。</p>
      <div class="mt-4 space-y-3 text-sm">
        <div>
          <label class="field-label">付款＋上載憑證頁</label>
          <div class="flex flex-wrap gap-2">
            <input class="field-input flex-1 font-mono text-xs" id="proofPayPageUrl" readonly value="<%= paymentLinks.proofPayPageUrl %>" />
            <button type="button" class="btn-secondary" data-copy="#proofPayPageUrl">複製</button>
            <a class="btn-primary" href="<%= paymentLinks.proofPayPageUrl %>" target="_blank" rel="noopener">開啟</a>
          </div>
        </div>
        <div>
          <label class="field-label">Airwallex 付款連結（<%= paymentLinks.packTierLabel %>｜應繳 HKD $<%= paymentLinks.feeTotal %>）</label>
          <div class="flex flex-wrap gap-2">
            <input class="field-input flex-1 font-mono text-xs" id="airwallexPayUrl" readonly value="<%= paymentLinks.airwallexPayUrl %>" />
            <button type="button" class="btn-secondary" data-copy="#airwallexPayUrl">複製</button>
            <a class="btn-primary" href="<%= paymentLinks.airwallexPayUrl %>" target="_blank" rel="noopener">開啟</a>
          </div>
        </div>
        <div>
          <label class="field-label">成功頁（申請摘要）</label>
          <div class="flex flex-wrap gap-2">
            <input class="field-input flex-1 font-mono text-xs" id="successPageUrl" readonly value="<%= paymentLinks.successPageUrl %>" />
            <button type="button" class="btn-secondary" data-copy="#successPageUrl">複製</button>
          </div>
        </div>
      </div>
    </div>

    <form method="post" action="/admin/teams/<%= team._id %>/edit" class="space-y-4">
      <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="font-semibold text-brand-deep">編輯隊伍資料</h2>
          <button type="submit" class="btn-primary">儲存報名資料</button>
        </div>
        <div class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
          <div>
            <label class="field-label">隊伍／組名</label>
            <input class="field-input" name="displayName" value="<%= team.displayName || '' %>" required />
          </div>
          <div>
            <label class="field-label">隊長電郵</label>
            <input class="field-input" type="email" name="captainEmail" value="<%= team.captainEmail || '' %>" required />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label">賽事報名邀請球會</label>
            <input class="field-input" name="captainClub" value="<%= team.captainClub || '' %>" required />
          </div>
          <div>
            <label class="field-label">年齡組別</label>
            <select class="field-input" name="ageGroup">
              <% Object.keys(labels.ageGroup).forEach(function(k){ %>
              <option value="<%= k %>" <%= team.ageGroup===k?'selected':'' %>><%= labels.ageGroup[k] %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label">競賽項目</label>
            <select class="field-input" name="eventCategory">
              <% Object.keys(labels.eventCategory).forEach(function(k){ %>
              <option value="<%= k %>" <%= team.eventCategory===k?'selected':'' %>><%= labels.eventCategory[k] %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label">選手包</label>
            <select class="field-input" name="packTier">
              <% Object.keys(labels.packTier).forEach(function(k){ %>
              <option value="<%= k %>" <%= tier===k?'selected':'' %>><%= labels.packTier[k] %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="field-label">報名類型（參考）</label>
            <input class="field-input" value="<%= labels.registrationType[team.registrationType] || team.registrationType || '—' %>" readonly />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label">首選場地</label>
            <input class="field-input" name="preferredVenueLabel" value="<%= team.preferredVenueLabel || '' %>" />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label">預計海選時間</label>
            <input class="field-input" name="qualifierSlotLabel" value="<%= team.qualifierSlotLabel || '' %>" />
          </div>
          <div><dt class="text-xs text-slate-500">提交時間</dt><dd><%= formatDateTime(team.submittedAt) %></dd></div>
          <div><dt class="text-xs text-slate-500">確認時間</dt><dd><%= formatDateTime(team.confirmedAt) || '—' %></dd></div>
        </div>
      </div>

      <% if (captain) { %>
      <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
        <h2 class="font-semibold text-brand-deep">編輯隊長</h2>
        <input type="hidden" name="captainId" value="<%= captain._id %>" />
        <div class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
          <div>
            <label class="field-label">中文姓名</label>
            <input class="field-input" name="captainChineseName" value="<%= captain.chineseName || '' %>" required />
          </div>
          <div>
            <label class="field-label">英文姓名</label>
            <input class="field-input" name="captainEnglishName" value="<%= captain.englishName || '' %>" required />
          </div>
          <div>
            <label class="field-label">性別</label>
            <select class="field-input" name="captainGender">
              <option value="male" <%= captain.gender==='male'?'selected':'' %>>男</option>
              <option value="female" <%= captain.gender==='female'?'selected':'' %>>女</option>
            </select>
          </div>
          <div>
            <label class="field-label">出生日期</label>
            <input class="field-input" type="date" name="captainDob" value="<%= formatDate(captain.dateOfBirth) %>" required />
          </div>
          <div>
            <label class="field-label">WhatsApp</label>
            <input class="field-input" name="captainWhatsapp" value="<%= captain.whatsapp || '' %>" required />
          </div>
          <div>
            <label class="field-label">電郵</label>
            <input class="field-input" type="email" name="captainEmailPlayer" value="<%= captain.email || '' %>" required />
          </div>
          <div>
            <label class="field-label">球會</label>
            <input class="field-input" name="captainClubPlayer" value="<%= captain.club || '' %>" />
          </div>
          <div>
            <label class="field-label">緊急聯絡人</label>
            <input class="field-input" name="captainEmergencyName" value="<%= captain.emergencyContact && captain.emergencyContact.name || '' %>" required />
          </div>
          <div>
            <label class="field-label">緊急聯絡電話</label>
            <input class="field-input" name="captainEmergencyPhone" value="<%= captain.emergencyContact && captain.emergencyContact.phone || '' %>" required />
          </div>
        </div>
      </div>
      <% } %>

      <% if (teammate) { %>
      <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
        <h2 class="font-semibold text-brand-deep">編輯隊友</h2>
        <input type="hidden" name="teammateId" value="<%= teammate._id %>" />
        <div class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
          <div>
            <label class="field-label">中文姓名</label>
            <input class="field-input" name="teammateChineseName" value="<%= teammate.chineseName || '' %>" required />
          </div>
          <div>
            <label class="field-label">英文姓名</label>
            <input class="field-input" name="teammateEnglishName" value="<%= teammate.englishName || '' %>" required />
          </div>
          <div>
            <label class="field-label">性別</label>
            <select class="field-input" name="teammateGender">
              <option value="male" <%= teammate.gender==='male'?'selected':'' %>>男</option>
              <option value="female" <%= teammate.gender==='female'?'selected':'' %>>女</option>
            </select>
          </div>
          <div>
            <label class="field-label">出生日期</label>
            <input class="field-input" type="date" name="teammateDob" value="<%= formatDate(teammate.dateOfBirth) %>" required />
          </div>
          <div>
            <label class="field-label">WhatsApp</label>
            <input class="field-input" name="teammateWhatsapp" value="<%= teammate.whatsapp || '' %>" required />
          </div>
          <div>
            <label class="field-label">電郵</label>
            <input class="field-input" type="email" name="teammateEmail" value="<%= teammate.email || '' %>" required />
          </div>
          <div>
            <label class="field-label">球會（如有）</label>
            <input class="field-input" name="teammateClub" value="<%= teammate.club || '' %>" />
          </div>
          <div>
            <label class="field-label">緊急聯絡人</label>
            <input class="field-input" name="teammateEmergencyName" value="<%= teammate.emergencyContact && teammate.emergencyContact.name || '' %>" required />
          </div>
          <div>
            <label class="field-label">緊急聯絡電話</label>
            <input class="field-input" name="teammateEmergencyPhone" value="<%= teammate.emergencyContact && teammate.emergencyContact.phone || '' %>" required />
          </div>
        </div>
      </div>
      <% } %>

      <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
        <button type="submit" class="btn-primary w-full sm:w-auto">儲存報名資料</button>
      </div>
    </form>

    <div id="payment-proof" class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-deep">付款憑證</h2>
      <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <div><dt class="text-xs text-slate-500">付款方式</dt><dd><%= team.payment && team.payment.method ? team.payment.method : '—' %></dd></div>
        <div><dt class="text-xs text-slate-500">付款參考</dt><dd class="font-mono text-xs"><%= team.payment && team.payment.paymentReference ? team.payment.paymentReference : '—' %></dd></div>
      </dl>
      <% var proof = team.payment && team.payment.proofUrl; var proofName = (team.payment && team.payment.proofOriginalName) || '付款憑證'; var isImg = proof && /\.(jpe?g|png|webp|gif)$/i.test(proof); %>
      <% if (proof) { %>
      <div class="mt-4">
        <% if (isImg) { %>
        <a href="<%= proof %>" target="_blank" rel="noopener">
          <img src="<%= proof %>" alt="付款憑證" class="max-h-96 w-auto max-w-full rounded-xl ring-1 ring-slate-200" />
        </a>
        <% } %>
        <p class="mt-2">
          <a class="text-brand-blue underline" href="<%= proof %>" target="_blank" rel="noopener"><%= proofName %></a>
          （開新分頁查看／下載）
        </p>
      </div>
      <% } else { %>
      <p class="mt-3 text-sm text-slate-500">尚未上載付款憑證。</p>
      <% } %>
    </div>

    <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-deep">市場研究／條款</h2>
      <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        <div><dt class="text-xs text-slate-500">嘉年華意向</dt><dd><%= team.research.carnivalIntent %></dd></div>
        <div><dt class="text-xs text-slate-500">技術程度</dt><dd><%= team.research.skillLevel %></dd></div>
        <div><dt class="text-xs text-slate-500">得知渠道</dt><dd><%= Array.isArray(team.research.hearAbout) ? team.research.hearAbout.join('、') : (team.research.hearAbout || '—') %></dd></div>
        <div><dt class="text-xs text-slate-500">行銷同意</dt><dd><%= team.agreements.marketing ? '是' : '否' %></dd></div>
        <div class="sm:col-span-2"><dt class="text-xs text-slate-500">興趣</dt><dd><%= (team.research.interests||[]).join('、') %></dd></div>
      </dl>
    </div>
  </section>

  <aside class="space-y-4">
    <form method="post" action="/admin/teams/<%= team._id %>/update" class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-deep">更新狀態</h2>
      <div class="mt-4 space-y-3">
        <div>
          <label class="field-label">報名狀態</label>
          <select class="field-input" name="status">
            <% Object.keys(labels.teamStatus).forEach(function(k){ %>
            <option value="<%= k %>" <%= team.status===k?'selected':'' %>><%= labels.teamStatus[k] %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="field-label">付款狀態</label>
          <select class="field-input" name="paymentStatus">
            <% Object.keys(labels.paymentStatus).forEach(function(k){ %>
            <option value="<%= k %>" <%= (team.payment&&team.payment.status)===k?'selected':'' %>><%= labels.paymentStatus[k] %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="field-label">資格審核</label>
          <select class="field-input" name="qualificationStatus">
            <% Object.keys(labels.qualificationStatus).forEach(function(k){ %>
            <option value="<%= k %>" <%= team.qualificationStatus===k?'selected':'' %>><%= labels.qualificationStatus[k] %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="field-label">隊伍編號</label>
          <input class="field-input" name="teamCode" value="<%= team.teamCode || '' %>" placeholder="GPCC-HK-0001" />
          <% if (!team.teamCode) { %>
          <label class="mt-2 flex items-center gap-2 text-xs text-slate-600">
            <input type="checkbox" name="assignTeamCode" value="1" /> 自動分配下一編號
          </label>
          <% } %>
        </div>
        <div>
          <label class="field-label">內部備註</label>
          <textarea class="field-input" name="notes" rows="4"><%= team.notes || '' %></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">儲存狀態</button>
      </div>
    </form>

    <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-deep">Wonder 付款紀錄（gpcchkmo 獨立）</h2>
      <ul class="mt-3 space-y-2 text-xs text-slate-600">
        <% if (!wonderPayments || !wonderPayments.length) { %>
        <li class="text-slate-400">尚未發起 Wonder 付款</li>
        <% } %>
        <% (wonderPayments || []).forEach(function(p){ %>
        <li class="rounded-lg bg-slate-50 px-3 py-2">
          <div class="font-mono text-[11px] text-brand-blue"><%= p.referenceNumber %></div>
          <div>狀態：<%= labels.paymentStatus[p.status] || p.status %> · HKD <%= p.amountHkd %></div>
          <div>provider：<%= p.provider %> · <%= formatDateTime(p.createdAt) %></div>
          <% if (p.paidAt) { %><div>付款時間：<%= formatDateTime(p.paidAt) %></div><% } %>
        </li>
        <% }) %>
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-deep">操作紀錄</h2>
      <ul class="mt-3 max-h-72 space-y-2 overflow-y-auto text-xs text-slate-600">
        <% if (!audits.length) { %><li class="text-slate-400">暫無紀錄</li><% } %>
        <% audits.forEach(function(a){ %>
        <li class="rounded-lg bg-slate-50 px-3 py-2">
          <div class="font-medium text-slate-800"><%= a.action %></div>
          <div><%= a.actor %> · <%= formatDateTime(a.createdAt) %></div>
        </li>
        <% }) %>
      </ul>
    </div>
  </aside>
</div>
<script>
  document.querySelectorAll('[data-copy]').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var input = document.querySelector(btn.getAttribute('data-copy'));
      if (!input) return;
      try {
        await navigator.clipboard.writeText(input.value);
        var old = btn.textContent;
        btn.textContent = '已複製';
        setTimeout(function () { btn.textContent = old; }, 1200);
      } catch (err) {
        input.select();
        document.execCommand('copy');
      }
    });
  });
</script>
<%- include('partials/foot') %>
