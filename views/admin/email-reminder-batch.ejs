<%- include('partials/head') %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <a href="/admin" class="text-sm text-brand-blue hover:underline">← 返回列表</a>
    <h1 class="mt-1 font-display text-2xl font-bold text-brand-deep">批次發送：賽前溫馨提示</h1>
    <p class="mt-1 text-sm text-slate-500">按海選場地／時段選擇，預覽後批次寄出提醒電郵（內容已按各賽區填寫）。</p>
  </div>
  <div class="flex flex-wrap gap-3 text-sm">
    <a href="/admin/email-templates" class="text-brand-blue hover:underline">編輯 HTML 範本</a>
    <span class="text-xs <%= mailConfigured ? 'text-emerald-700' : 'text-amber-700' %>">
      Gmail：<%= mailConfigured ? '已設定' : '未設定' %>
    </span>
  </div>
</div>

<% if (flash) { %>
<div class="mb-4 rounded-xl bg-emerald-50 px-4 py-2 text-sm text-emerald-800 ring-1 ring-emerald-200"><%= flash %></div>
<% } %>

<form method="get" action="/admin/email-reminder-batch" class="mb-5 rounded-2xl bg-white p-4 shadow-panel ring-1 ring-slate-200">
  <label class="field-label">選擇海選時段</label>
  <div class="mt-2 flex flex-wrap gap-2">
    <select class="field-input max-w-xl" name="slot" onchange="this.form.submit()">
      <option value="">— 請選擇 —</option>
      <% (slots || []).forEach(function(s){ %>
      <option value="<%= s.id %>" <%= selectedSlotId===s.id?'selected':'' %>>
        <%= s.venueCode %> <%= s.venueShort %>｜<%= s.slotLabel %>（<%= s.matchDateText %> 星期<%= s.weekday %>）
      </option>
      <% }) %>
    </select>
    <button type="submit" class="btn-secondary">載入名單</button>
  </div>
</form>

<% if (slot) { %>
<div class="grid gap-5 lg:grid-cols-2">
  <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
    <h2 class="font-semibold text-brand-deep">時段資料</h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div><dt class="text-xs text-slate-500">場地</dt><dd><%= slot.venueShort %>（<%= slot.venueCode %>）</dd></div>
      <div><dt class="text-xs text-slate-500">時段／組別</dt><dd><%= slot.slotLabel %></dd></div>
      <div><dt class="text-xs text-slate-500">比賽日期</dt><dd><%= slot.matchDateText %>（星期<%= slot.weekday %>）</dd></div>
      <div><dt class="text-xs text-slate-500">報到</dt><dd><%= slot.checkInTime %></dd></div>
      <div><dt class="text-xs text-slate-500">開賽</dt><dd><%= slot.startTime %></dd></div>
      <div><dt class="text-xs text-slate-500">地點</dt><dd><%= slot.venueAddress %></dd></div>
    </dl>

    <h2 class="mt-6 font-semibold text-brand-deep">符合隊伍（<%= matched.length %>）</h2>
    <% if (!matched.length) { %>
    <p class="mt-2 text-sm text-slate-500">系統內暫無符合此場地／時段的報名（請確認 preferredVenue／qualifierSlot 資料）。</p>
    <% } else { %>
    <form method="post" action="/admin/email-reminder-batch" class="mt-3" onsubmit="return confirm('確認向已勾選的 <%= matched.length %> 隊發送提醒電郵？');">
      <input type="hidden" name="slot" value="<%= slot.id %>" />
      <div class="mb-2 flex gap-2 text-xs">
        <button type="button" class="text-brand-blue underline" onclick="document.querySelectorAll('.team-check').forEach(function(c){c.checked=true})">全選</button>
        <button type="button" class="text-slate-500 underline" onclick="document.querySelectorAll('.team-check').forEach(function(c){c.checked=false})">全不選</button>
      </div>
      <ul class="max-h-80 space-y-1 overflow-y-auto text-sm">
        <% matched.forEach(function(t){ %>
        <li class="flex items-start gap-2 rounded-lg bg-slate-50 px-2 py-1.5">
          <input class="team-check mt-1" type="checkbox" name="teamIds" value="<%= t._id %>" checked />
          <div>
            <div class="font-medium text-slate-800"><%= t.displayName || '—' %> <span class="font-mono text-xs text-brand-blue"><%= t.teamCode || '' %></span></div>
            <div class="text-xs text-slate-500"><%= t.captainEmail %></div>
            <div class="text-xs text-slate-400"><%= t.qualifierSlotLabel || t.preferredVenueLabel %></div>
          </div>
        </li>
        <% }) %>
      </ul>
      <button type="submit" class="btn-primary mt-4" <%= !mailConfigured ? 'disabled' : '' %>>批次發送提醒電郵</button>
    </form>
    <% } %>
  </div>

  <div class="rounded-2xl bg-white p-5 shadow-panel ring-1 ring-slate-200">
    <h2 class="font-semibold text-brand-deep">電郵預覽</h2>
    <% if (preview) { %>
    <p class="mt-2 text-xs text-slate-500">主旨：<%= preview.subject %></p>
    <div class="mt-3 max-h-[36rem] overflow-auto rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm">
      <%- preview.html %>
    </div>
    <% } %>
  </div>
</div>
<% } %>
<%- include('partials/foot') %>
