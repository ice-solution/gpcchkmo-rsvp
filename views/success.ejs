<%- include('partials/head') %>
<main class="mx-auto max-w-xl px-4 py-12">
  <div class="overflow-hidden rounded-3xl bg-white shadow-panel ring-1 ring-slate-200">
    <div class="bg-gradient-to-r from-brand-deep to-brand-blue px-6 py-5 text-white">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-lime">GPCC Hong Kong</p>
      <h1 class="mt-2 font-display text-2xl font-bold">
        <% if (teamPaymentStatus === 'paid' || paymentState === 'paid') { %>
          已收到付款｜待資格核實
        <% } else { %>
          已收到報名申請
        <% } %>
      </h1>
    </div>
    <div class="space-y-4 px-6 py-6 text-sm leading-relaxed text-slate-700">
      <% if (teamPaymentStatus === 'paid' || paymentState === 'paid') { %>
      <p class="rounded-2xl bg-emerald-50 px-4 py-3 text-emerald-900 ring-1 ring-emerald-200">
        付款已收到。此階段<strong>仍未等同報名成功</strong>；待大會核實資格後才會發正式確認、隊伍編號及 QR Code。
      </p>
      <% } else if (!paymentGatewayEnabled) { %>
      <p class="rounded-2xl bg-amber-50 px-4 py-3 text-amber-900 ring-1 ring-amber-200">
        已收到您的報名申請<% if (teamStatusLabel) { %>（<%= teamStatusLabel %>）<% } %>。請按下方按鈕前往付款頁，完成付款並上載收據。
      </p>
      <% } else { %>
      <p class="rounded-2xl bg-amber-50 px-4 py-3 text-amber-900 ring-1 ring-amber-200">
        此階段<strong>尚未等同報名成功</strong>。請先完成網上付款；系統不會在此刻發放隊伍編號或 QR Code。
      </p>
      <% } %>

      <% if (applicationId) { %>
      <p>申請參考編號：<span class="font-mono font-semibold text-brand-deep"><%= applicationId %></span></p>
      <% } %>
      <% if (paymentReference) { %>
      <p>轉賬備註／參考：<span class="font-mono font-semibold text-brand-deep"><%= paymentReference %></span></p>
      <% } %>

      <% if (team) { %>
      <div class="rounded-2xl bg-slate-50 px-4 py-4 ring-1 ring-slate-200">
        <p class="font-semibold text-brand-deep">申請詳情</p>
        <dl class="mt-3 grid gap-2 sm:grid-cols-2">
          <div><dt class="text-xs text-slate-500">申請狀態</dt><dd><%= teamStatusLabel || '—' %></dd></div>
          <div><dt class="text-xs text-slate-500">付款狀態</dt><dd><%= paymentStatusLabel || '—' %></dd></div>
          <div><dt class="text-xs text-slate-500">隊伍名稱</dt><dd><%= team.displayName || '—' %></dd></div>
          <div><dt class="text-xs text-slate-500">隊長球會</dt><dd><%= team.captainClub || '—' %></dd></div>
          <div class="sm:col-span-2"><dt class="text-xs text-slate-500">隊長電郵</dt><dd><%= team.captainEmail || '—' %></dd></div>
          <div><dt class="text-xs text-slate-500">年齡組別</dt><dd><%= labels.ageGroup[team.ageGroup] || team.ageGroup %></dd></div>
          <div><dt class="text-xs text-slate-500">競賽項目</dt><dd><%= labels.eventCategory[team.eventCategory] || team.eventCategory %></dd></div>
          <div class="sm:col-span-2"><dt class="text-xs text-slate-500">首選場地</dt><dd><%= team.preferredVenueLabel || '—' %></dd></div>
          <% if (team.qualifierSlotLabel) { %>
          <div class="sm:col-span-2"><dt class="text-xs text-slate-500">預計海選時間</dt><dd><%= team.qualifierSlotLabel %></dd></div>
          <% } %>
          <div class="sm:col-span-2"><dt class="text-xs text-slate-500">選手包套裝</dt><dd><%= packTierLabel || '—' %><% if (packFee > 0) { %>（加購 HKD $<%= packFee %>）<% } %></dd></div>
        </dl>
      </div>
      <% } %>

      <% if (captain) { %>
      <div class="rounded-2xl bg-slate-50 px-4 py-4 ring-1 ring-slate-200">
        <p class="font-semibold text-brand-deep">隊長</p>
        <p class="mt-2"><%= captain.chineseName %>／<%= captain.englishName %>（<%= captain.gender === 'male' ? '男' : '女' %>）</p>
        <p>出生日期：<%= formatDate(captain.dateOfBirth) %></p>
        <p>WhatsApp：<%= captain.whatsapp %></p>
      </div>
      <% } %>

      <% if (teammate) { %>
      <div class="rounded-2xl bg-slate-50 px-4 py-4 ring-1 ring-slate-200">
        <p class="font-semibold text-brand-deep">隊友</p>
        <p class="mt-2"><%= teammate.chineseName %>／<%= teammate.englishName %>（<%= teammate.gender === 'male' ? '男' : '女' %>）</p>
        <p>出生日期：<%= formatDate(teammate.dateOfBirth) %></p>
        <p>WhatsApp：<%= teammate.whatsapp %></p>
        <p>電郵：<%= teammate.email %></p>
      </div>
      <% } %>

      <ul class="list-disc space-y-2 pl-5">
        <li>海選報名費：HKD $<%= feeBase %>／隊（兩名球員）</li>
        <% if (packFee > 0) { %>
        <li>套裝加購（<%= packTierLabel %>）：HKD $<%= packFee %></li>
        <% } %>
        <% if (paymentGatewayEnabled) { %>
        <li>平台手續費 3%：HKD $<%= feeSurcharge %></li>
        <% } %>
        <li>應繳總額：<strong>HKD $<%= feeTotal %></strong></li>
      </ul>

      <div id="pay-error" class="hidden rounded-xl bg-red-50 px-3 py-2 text-sm text-red-700 ring-1 ring-red-200"></div>

      <div class="flex flex-wrap gap-3 pt-2">
        <% if (!paymentGatewayEnabled && applicationId && teamPaymentStatus !== 'paid') { %>
        <a href="/rsvp/pay?id=<%= encodeURIComponent(applicationId) %>" class="btn-primary">前往付款</a>
        <% } %>
        <% if (applicationId && paymentGatewayEnabled && wonderConfigured && teamPaymentStatus !== 'paid') { %>
        <button type="button" id="btn-pay-wonder" class="btn-primary" data-team-id="<%= applicationId %>">
          立即以 Wonder 付款 HKD $<%= feeTotal %>
        </button>
        <% } %>
        <a href="/rsvp" class="btn-secondary">返回報名表</a>
        <a href="https://gpcchkmo.org/" class="btn-secondary" target="_blank" rel="noopener">官方網站</a>
      </div>
    </div>
  </div>
</main>
<script>
(function () {
  var btn = document.getElementById('btn-pay-wonder');
  if (!btn) return;
  var err = document.getElementById('pay-error');
  var params = new URLSearchParams(window.location.search);
  async function startPay() {
    btn.disabled = true;
    btn.textContent = '建立付款連結中…';
    err.classList.add('hidden');
    try {
      var res = await fetch('/api/gpcchkmo/wonder/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ teamId: btn.getAttribute('data-team-id') }),
      });
      var json = await res.json();
      if (!json.ok || !json.data || !json.data.paymentUrl) {
        throw new Error((json.errors && json.errors[0]) || '無法建立付款');
      }
      window.location.href = json.data.paymentUrl;
    } catch (e) {
      err.textContent = e.message || '付款連結建立失敗';
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = '立即以 Wonder 付款 HKD $<%= feeTotal %>';
    }
  }
  btn.addEventListener('click', startPay);
  if (params.get('pay') === '1' && params.get('payment') !== 'return') {
    startPay();
  }
})();
</script>
<%- include('partials/foot') %>
