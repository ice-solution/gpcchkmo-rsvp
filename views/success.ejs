<%- include('partials/head') %>
<main class="mx-auto max-w-xl px-4 py-12">
  <div class="overflow-hidden rounded-3xl bg-white shadow-panel ring-1 ring-slate-200">
    <div class="bg-gradient-to-r from-brand-deep to-brand-blue px-6 py-5 text-white">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-lime">GPCC Hong Kong</p>
      <h1 class="mt-2 font-display text-2xl font-bold">
        <% if (teamPaymentStatus === 'paid' || paymentState === 'paid') { %>
          已收到付款｜待資格核實
        <% } else if (!paymentGatewayEnabled) { %>
          已收到報名申請｜人工待付
        <% } else { %>
          已收到報名申請
        <% } %>
      </h1>
    </div>
    <div class="space-y-4 px-6 py-6 text-sm leading-relaxed text-slate-700">
      <% if (teamPaymentStatus === 'paid' || paymentState === 'paid') { %>
      <p class="rounded-2xl bg-emerald-50 px-4 py-3 text-emerald-900 ring-1 ring-emerald-200">
        付款已收到。此階段<strong>仍未等同報名成功</strong>；待大會核實資格後才會發正式確認、隊伍編號及 QR Code。
      </p>
      <% } else if (!paymentGatewayEnabled) { %>
      <p class="rounded-2xl bg-amber-50 px-4 py-3 text-amber-900 ring-1 ring-amber-200">
        申請狀態為<strong>人工待付</strong>。此階段<strong>尚未等同報名成功</strong>；請確認已完成轉賬並保留付款憑證。
      </p>
      <% } else { %>
      <p class="rounded-2xl bg-amber-50 px-4 py-3 text-amber-900 ring-1 ring-amber-200">
        此階段<strong>尚未等同報名成功</strong>。請先完成網上付款；系統不會在此刻發放隊伍編號或 QR Code。
      </p>
      <% } %>

      <% if (applicationId) { %>
      <p>申請參考編號：<span class="font-mono font-semibold text-brand-deep"><%= applicationId %></span></p>
      <% } %>
      <% if (paymentReference) { %>
      <p>轉賬備註／參考：<span class="font-mono font-semibold text-brand-deep"><%= paymentReference %></span></p>
      <% } %>

      <% if (!paymentGatewayEnabled && teamPaymentStatus !== 'paid') { %>
      <div class="rounded-2xl bg-sky-50 px-4 py-4 ring-1 ring-brand-blue/20">
        <img src="/images/fps_logo.jpg" alt="轉數快 FPS" class="mb-3 h-12 w-auto object-contain" />
        <p>請於提交表格前完成轉賬，並拍照/截圖保存付款憑證。</p>
        <p class="mt-2">基本費用：HKD $<%= feeBase %> / 隊</p>
        <% if (wantPlayerPack) { %>
        <p>選手包加購：HKD $<%= packFee %>（兩人份）</p>
        <% } %>
        <p>應繳總額：<strong>HKD $<%= feeTotal %></strong></p>
        <p class="mt-2">轉數快 (FPS) 識別碼 / FPS #：<strong>133515288</strong>（大會指定收款戶口：Moves Sports Limited）</p>
        <p>WhatsApp：<a class="font-semibold text-brand-blue underline" href="https://wa.me/85297232341" target="_blank" rel="noopener">97232341</a></p>
        <p class="mt-2">銀行: OCBC Bank (Hong Kong)<br />戶口號碼: 802030689001<br />銀行代碼: 035</p>
        <img src="/images/fps.jpg" alt="轉數快收款 QR Code" class="mx-auto mt-4 w-full max-w-[200px] rounded-xl bg-white p-2 ring-1 ring-slate-200" />
      </div>
      <% if (proofUrl || proofLink) { %>
      <p>已收到付款憑證：
        <% if (proofUrl) { %><a class="text-brand-blue underline" href="<%= proofUrl %>" target="_blank" rel="noopener">查看上載檔案</a><% } %>
        <% if (proofUrl && proofLink) { %> · <% } %>
        <% if (proofLink) { %><a class="text-brand-blue underline" href="<%= proofLink %>" target="_blank" rel="noopener">憑證連結</a><% } %>
      </p>
      <% } %>
      <% } else { %>
      <ul class="list-disc space-y-2 pl-5">
        <li>海選報名費：HKD $<%= feeBase %>／隊（兩名球員）</li>
        <% if (wantPlayerPack) { %>
        <li>選手包加購：HKD $<%= packFee %>（兩人份）</li>
        <% } %>
        <% if (paymentGatewayEnabled) { %>
        <li>Wonder 平台手續費 3%（參加者承擔）：HKD $<%= feeSurcharge %></li>
        <% } %>
        <li>應繳總額：<strong>HKD $<%= feeTotal %></strong></li>
        <li>付款成功不等於報名成功；待資格及重複報名核實後才發正式確認</li>
      </ul>
      <% } %>

      <div id="pay-error" class="hidden rounded-xl bg-red-50 px-3 py-2 text-sm text-red-700 ring-1 ring-red-200"></div>

      <div class="flex flex-wrap gap-3 pt-2">
        <% if (applicationId && paymentGatewayEnabled && wonderConfigured && teamPaymentStatus !== 'paid') { %>
        <button type="button" id="btn-pay-wonder" class="btn-primary" data-team-id="<%= applicationId %>">
          立即以 Wonder 付款 HKD $<%= feeTotal %>
        </button>
        <% } %>
        <a href="/rsvp" class="btn-secondary">返回報名表</a>
        <a href="https://gpcchkmo.org/" class="btn-secondary" target="_blank" rel="noopener">官方網站</a>
      </div>
    </div>
  </div>
</main>
<script>
(function () {
  var btn = document.getElementById('btn-pay-wonder');
  if (!btn) return;
  var err = document.getElementById('pay-error');
  var params = new URLSearchParams(window.location.search);
  async function startPay() {
    btn.disabled = true;
    btn.textContent = '建立付款連結中…';
    err.classList.add('hidden');
    try {
      var res = await fetch('/api/gpcchkmo/wonder/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ teamId: btn.getAttribute('data-team-id') }),
      });
      var json = await res.json();
      if (!json.ok || !json.data || !json.data.paymentUrl) {
        throw new Error((json.errors && json.errors[0]) || '無法建立付款');
      }
      window.location.href = json.data.paymentUrl;
    } catch (e) {
      err.textContent = e.message || '付款連結建立失敗';
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = '立即以 Wonder 付款 HKD $<%= feeTotal %>';
    }
  }
  btn.addEventListener('click', startPay);
  if (params.get('pay') === '1' && params.get('payment') !== 'return') {
    startPay();
  }
})();
</script>
<%- include('partials/foot') %>
